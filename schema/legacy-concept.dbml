
Table genders {
  id boolean [primary key]
  name varchar(255) [not null, unique]
  description text
  code char(1) [not null, unique]
  is_active boolean [not null, default: false]
}

Table countries {
  id integer [primary key]
  name varchar(255) [not null, unique]
  iso2_code char(2) [not null, unique]
  iso3_code char(3) [not null, unique]
  iso_numeric_code char(3) [unique]
  phone_code varchar(10) [not null]
  is_active boolean [not null, default: false]
  created_at timestamp
  updated_at timestamp
}

Table user_statuses {
  id integer [primary key]
  name varchar(50) [not null, unique]
  code varchar(30) [not null, unique]
  description text
  is_active boolean [not null, default: false]
  created_at timestamp
  updated_at timestamp
}

Table timezones {
  id integer [primary key]
  iana_name varchar(100) [not null, unique]
  display_name varchar(100) [not null]
  is_active boolean [not null, default: false]
  created_at timestamp
  updated_at timestamp
}

Table user_sessions {
  id bigint [primary key]
  user_id integer [not null]
  session_token varchar(255) [not null, unique]
  ip_address varchar(45) [not null]
  user_agent text [not null]
  created_at timestamp
  expires_at timestamp [not null]
  last_activity_at timestamp
  is_active boolean [not null, default: true]
}

Table login_history {
  id bigint [primary key]
  user_id integer [not null]
  email varchar(255)
  ip_address varchar(45) [not null]
  user_agent text
  success boolean [not null]
  failure_reason varchar(255)
  created_at timestamp
}

Table user_devices {
  id bigint [primary key]
  user_id integer [not null]
  device_name varchar(255)
  device_fingerprint varchar(255) [not null, unique]
  last_login_at timestamp
  is_trusted boolean [not null, default: false]
  created_at timestamp
  updated_at timestamp
}

Table password_history {
  id bigint [primary key]
  user_id integer [not null]
  password_hash varchar(255) [not null]
  created_at timestamp
}

Table users {
  id bigint [primary key]
  uuid uuid [not null, unique]
  email varchar(255) [not null, unique]
  username varchar(50) [not null, unique]
  password_hash varchar(255) [not null]
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  phone varchar(30)
  profile_photo varchar(500)
  birth_date date
  dark_mode boolean [not null, default: false]
  email_verified boolean [not null, default: false]
  gender_id boolean
  country_id integer [not null]
  language_native_id integer
  language_ui_id integer
  timezone_id integer
  status_id integer
  created_at timestamp
  updated_at timestamp
}

Table concepts {
  id integer [pk, increment]
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table concept_image_assets {
  id integer [pk, increment]
  concept_id integer [not null]
  is_realistic boolean [not null]
  file_path text [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (concept_id, is_realistic) [unique]
  }
}

Table concept_translations {
  id bigint [pk, increment]
  concept_id integer [not null]
  language_id smallint [not null]
  written_form varchar(255) [not null]
  phonetic_form varchar(255)
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (concept_id, language_id) [unique]
  }
}

Table concept_relationships {
  id bigint [pk, increment]
  source_concept_id integer [not null]
  relationship_type_id smallint [not null]
  target_concept_id integer [not null]
  created_at timestamp [not null]
  
  checks {
    `source_concept_id <> target_concept_id`
  }

  indexes {
    (source_concept_id, relationship_type_id, target_concept_id) [unique]
  }
}

Table relationship_types {
  id smallint [pk, increment]
  code varchar(100) [unique]
  name varchar(255) [unique]
  description text
  is_symmetric boolean [not null, default: false]
}

Table languages {
  id smallint [primary key]
  name varchar(255) [not null, unique]
  iso_639_1 char(2) [not null, unique]
  iso_639_3 char(3) [not null, unique]
  is_right_to_left boolean [not null, default: false]
  is_bottom_to_top boolean [not null, default: false]
  is_active boolean [not null, default: false]
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

/* Module - Study */
Ref: concept_translations.concept_id > concepts.id
Ref: concept_translations.language_id > languages.id
Ref: concept_image_assets.concept_id > concepts.id
Ref: concept_relationships.source_concept_id > concepts.id
Ref: concept_relationships.target_concept_id > concepts.id
Ref: concept_relationships.relationship_type_id > relationship_types.id

/* Module - users */
Ref: users.country_id > countries.id
Ref: users.gender_id > genders.id
Ref: users.language_native_id > languages.id
Ref: users.language_ui_id > languages.id
Ref: users.status_id > user_statuses.id
Ref: users.timezone_id > timezones.id

Ref: user_sessions.user_id > users.id
Ref: login_history.user_id > users.id
Ref: user_devices.user_id > users.id
Ref: password_history.user_id > users.id

